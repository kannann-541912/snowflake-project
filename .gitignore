# Snowflake CLI
out/
.snow/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env

# Secrets - NEVER commit
config.toml
*.pem
*.key
*.p8
profiles.yml        # dbt profiles — copy from profiles.yml.example

# Terraform — state holds provisioned values in plaintext, never commit
terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/

# Airflow
airflow.db
airflow.cfg
airflow/logs/
webserver_config.py

# Agent eval results (generated at runtime, one dir per agent)
agent/agents/*/evals/results/*.json

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
