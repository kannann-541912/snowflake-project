# dbt profile template — copy to ~/.dbt/profiles.yml and set SNOWFLAKE_PAT env var.
# NEVER commit the actual profiles.yml — it may contain secrets.
#
# Authentication: Snowflake Programmatic Access Token (PAT)
# Set env var:  export SNOWFLAKE_PAT=<your-pat>

tpch_data_platform:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: A5701997473071-MPA05784
      user: DBT_DEV_SERVICE_USER
      authenticator: programmatic_access_token
      token: "{{ env_var('SNOWFLAKE_PAT') }}"
      role: ACCOUNTADMIN
      database: SANDBOX
      warehouse: ANALYTICS_WH
      schema: TPCH
      threads: 8
      client_session_keep_alive: false
      query_tag: "dbt_dev"

    prod:
      type: snowflake
      account: "xna38553.east-us-2.azure"
      user: "MCP_SERVICE_USER"
      authenticator: programmatic_access_token
      token: "{{ env_var('SNOWFLAKE_PAT') }}"
      role: ACCOUNTADMIN
      database: SANDBOX
      warehouse: ANALYTICS_WH
      schema: TPCH
      threads: 8
      client_session_keep_alive: false
      query_tag: "dbt_prod"

    ci:
      type: snowflake
      account: "xna38553.east-us-2.azure"
      user: "MCP_SERVICE_USER"
      authenticator: programmatic_access_token
      token: "{{ env_var('SNOWFLAKE_PAT') }}"
      role: ACCOUNTADMIN
      database: SANDBOX
      warehouse: ANALYTICS_WH
      schema: "TPCH_CI_{{ env_var('CI_RUN_ID', 'local') }}"
      threads: 4
      client_session_keep_alive: false
      query_tag: "dbt_ci"
