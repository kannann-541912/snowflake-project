        v.NAME                      AS MODEL_VERSION,
        'XGBClassifier'             AS MODEL_TYPE,
        CASE WHEN v.IS_DEFAULT_VERSION THEN 'ACTIVE' ELSE 'ARCHIVED' END AS MODEL_STATUS,
        v.CREATED_ON                AS LAST_TRAINED_AT,
        v.CREATED_ON                AS CREATED_AT,
        ROW_NUMBER() OVER (ORDER BY v.CREATED_ON DESC) AS rn
    FROM TABLE(
        SNOWFLAKE.ML.MODEL_VERSION_DETAILS(
            MODEL_NAME => 'DEMO_DEV.FRAUD_INTELLIGENCE.FRAUD_DETECTION_MODEL'
        )
    ) v
)
WHERE rn = 1
