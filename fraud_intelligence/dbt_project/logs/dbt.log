    c.FULL_NAME,
    c.RISK_SEGMENT,
    c.KYC_COMPLETE,
    c.IS_SYNTHETIC_FLAG,
    c.IS_MERGER_DUP_FLAG,
    c.ACCOUNT_COUNT,
